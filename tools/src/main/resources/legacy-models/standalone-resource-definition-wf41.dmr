                                            },
                                            "logout-path" => {
                                                "type" => STRING,
                                                "description" => "Optional relative path (starting with `/`) for the application endpoint that starts RP-initiated logout. Configure only when users initiate logout from the application; not used by front-channel or back-channel logout. No default value. Must match the incoming request path exactly.",
                                                "expressions-allowed" => true,
                                                "required" => false,
                                                "nillable" => true,
                                                "min-length" => 0L,
                                                "max-length" => 2147483647L,
                                                "stability" => "default"
                                            },
                                            "logout-session-required" => {
                                                "type" => BOOLEAN,
                                                "description" => "A boolean value. When true (default), front-channel logout validates the provider sid against the ID token `sid` claim and enforces `iss`. When false, front-channel logout skips those checks and invalidates the local session on the callback request. For back-channel logout to be executed, the value must be `true`. When value is `false`, the `back-channel` logout is rejected with HTTP 400.",
                                                "expressions-allowed" => true,
                                                "required" => false,
                                                "nillable" => true,
