                            "attributes" => {
                                "auto-deploy-exploded" => {
                                    "type" => BOOLEAN,
                                    "description" => "Allows the automatic deployment of exploded content without requiring a .dodeploy marker file. Recommended for only basic development scenarios to prevent exploded application deployment from occurring during changes by the developer or operating system.",
