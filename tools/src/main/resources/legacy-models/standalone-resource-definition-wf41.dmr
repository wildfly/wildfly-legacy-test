                                            },
                                            "logout-callback-path" => {
                                                "type" => STRING,
                                                "description" => "Optional relative path or absolute `http`/`https` URI where the OpenID Provider invokes front-channel or back-channel logout. Only the path component is matched against the incoming request, using exact path equality. No default value. Must be registered with the OpenID Provider. Required in practice for front-channel or back-channel logout.",
