                                "operations" => {
                                    "add" => {
                                        "operation-name" => "add",
                                        "description" => "Add configuration to be used to secure the management console using the Keycloak OpenID provider.",
                                        "request-properties" => {
                                            "adapter-state-cookie-path" => {
                                                "type" => STRING,
                                                "description" => "If set, this defines the path used in cookies set by the subsystem. This is useful when deploying an application in the root context path.",
