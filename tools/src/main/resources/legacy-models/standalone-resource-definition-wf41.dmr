        "reload-enhanced" => {
            "operation-name" => "reload-enhanced",
            "description" => "Reloads the server by shutting down all its services and starting again. The JVM itself is not restarted. This is similar to the 'reload' operation, but exposes some more advanced options.",
            "request-properties" => {
                "admin-only" => {
                    "type" => BOOLEAN,
                    "description" => "Whether the server should start in running mode ADMIN_ONLY when it restarts. An ADMIN_ONLY server will start any configured management interfaces and accept management requests, but will not start services used for handling end user requests.",
                    "expressions-allowed" => false,
                    "required" => false,
                    "nillable" => true,
                    "default" => false,
                    "alternatives" => ["start-mode"],
                    "stability" => "default",
                    "deprecated" => {
                        "since" => "5.0.0",
                        "reason" => "Use start-mode=admin-only instead."
                    }
                },
                "use-current-server-config" => {
                    "type" => BOOLEAN,
                    "description" => "Only has an effect if --read-only-server-config was specified when starting the server. In that case, if this parameter is set to false the reloaded server loads the original configuration version; if null or true the current runtime version of the model is used.",
                    "expressions-allowed" => false,
                    "required" => false,
                    "nillable" => true,
                    "default" => true,
                    "alternatives" => ["server-config"],
                    "stability" => "default"
                },
                "server-config" => {
                    "type" => STRING,
                    "description" => "Use to override the name of the server config to use for the reloaded server.  When making changes to the model after the reload, the changes will still be persisted to the original server configuration file that was first used to boot up the server. This parameter is resolved the same way as the --server-config command-line option.",
                    "expressions-allowed" => false,
                    "required" => false,
                    "nillable" => true,
                    "alternatives" => ["use-current-server-config"],
                    "min-length" => 1L,
                    "max-length" => 2147483647L,
                    "stability" => "default"
                },
                "start-mode" => {
                    "type" => STRING,
                    "description" => "Can be either normal, suspend or admin-only. If it is suspend the server will be started in suspended mode, if it is admin only the server will be started in admin-only mode.",
                    "expressions-allowed" => false,
                    "required" => false,
                    "nillable" => true,
                    "default" => "normal",
                    "alternatives" => ["admin-only"],
                    "allowed" => [
                        "normal",
                        "admin-only",
                        "suspend"
                    ],
                    "stability" => "default"
                },
                "stability" => {
                    "type" => STRING,
                    "description" => "Set to change the stability level of the reloaded server.",
                    "expressions-allowed" => false,
                    "required" => false,
                    "nillable" => true,
                    "allowed" => [
                        "default",
                        "community",
                        "preview",
                        "experimental"
                    ],
                    "stability" => "community"
                }
            },
            "reply-properties" => {},
            "access-constraints" => {"sensitive" => {"reload-enhanced" => {"type" => "core"}}},
            "stability" => "community",
            "read-only" => false,
            "runtime-only" => true
        },
