                        "global-directory" => {
                            "description" => "Global directory that can be used to supply libraries across all deployed applications.",
                            "model-description" => {"*" => {
                                "description" => "Global directory that can be used to supply libraries across all deployed applications.",
                                "stability" => "default",
                                "capabilities" => [{
                                    "name" => "org.wildfly.ee.global-directory",
