                                                                    "required" => false,
                                                                    "nillable" => true,
                                                                    "capability-reference" => "org.wildfly.management.path",
                                                                    "min-length" => 1L,
                                                                    "max-length" => 2147483647L,
                                                                    "stability" => "default",
                                                                    "deprecated" => {
