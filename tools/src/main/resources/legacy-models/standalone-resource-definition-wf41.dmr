                                                                    "required" => false,
                                                                    "nillable" => true,
                                                                    "stability" => "default",
                                                                    "value-type" => STRING,
                                                                    "access-type" => "read-write",
                                                                    "storage" => "configuration",
                                                                    "restart-required" => "resource-services"
                                                                },
                                                                "purge" => {
                                                                    "type" => BOOLEAN,
                                                                    "description" => "If true, purges this cache store when it starts up.",
                                                                    "expressions-allowed" => true,
                                                                    "required" => false,
