                                        },
                                        "value-type" => {
                                            "all" => {
                                                "type" => OBJECT,
                                                "description" => "A filter consisting of several filters in a chain.  If any filter finds the log message to be unloggable,the message will not be logged and subsequent filters will not be checked.",
