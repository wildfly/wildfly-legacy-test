                    "notifications" => undefined,
                    "children" => {
                        "log-store" => {
                            "description" => "Representation of the transaction logging storage mechanism.",
                            "model-description" => {"log-store" => {
                                "description" => "Representation of the transaction logging storage mechanism.",
                                "stability" => "default",
                                "attributes" => {
                                    "expose-all-logs" => {
                                        "type" => BOOLEAN,
                                        "description" => "Configures the behaviour of the probe operation. When true then all transaction log records are exposed. By default only a subset of the transaction log is exposed.",
                                        "expressions-allowed" => true,
                                        "required" => false,
                                        "nillable" => true,
