                                                "expressions-allowed" => true,
                                                "required" => false,
                                                "nillable" => true,
                                                "alternatives" => ["provider-url"],
                                                "min-length" => 1L,
                                                "max-length" => 2147483647L,
                                                "stability" => "default"
                                            },
                                            "authentication-request-format" => {
                                                "type" => STRING,
                                                "description" => "The format to use for specifying query parameters in authentication request.",
                                                "expressions-allowed" => true,
                                                "required" => false,
                                                "nillable" => true,
