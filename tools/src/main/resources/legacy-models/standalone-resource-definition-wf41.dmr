                                                    "operation-name" => "add",
                                                    "description" => "Add listener",
                                                    "request-properties" => {
                                                        "allow-encoded-slash" => {
                                                            "type" => BOOLEAN,
                                                            "description" => "If a request comes in with encoded / characters (i.e. %2F), will these be decoded.",
