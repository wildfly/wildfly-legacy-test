                                                    "type" => BOOLEAN,
                                                    "description" => "If this is true then Undertow will allow non-escaped equals characters in unquoted cookie values. Unquoted cookie values may not contain equals characters. If present the value ends before the equals sign. The remainder of the cookie value will be dropped.",
                                                    "expressions-allowed" => true,
                                                    "required" => false,
                                                    "nillable" => true,
                                                    "default" => false,
                                                    "stability" => "default",
                                                    "access-type" => "read-write",
                                                    "storage" => "configuration",
                                                    "restart-required" => "no-services"
                                                },
                                                "allow-unescaped-characters-in-url" => {
                                                    "type" => BOOLEAN,
                                                    "description" => "If this is true Undertow will accept non-encoded characters that are disallowed by the URI specification. This defaults to false, and in general should not be needed as most clients correctly encode characters. Note that setting this to true can be considered a security risk, as allowing non-standard characters can allow request smuggling attacks in some circumstances.",
